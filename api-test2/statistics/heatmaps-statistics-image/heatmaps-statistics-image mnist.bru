meta {
  name: heatmaps-statistics-image mnist
  type: http
  seq: 1
}

post {
  url: http://localhost:8000/heatmap/heatmaps-statistics-image-insertion-deletion
  body: json
  auth: inherit
}

body:json {
  {
    "model": "fashion",
    "dataset": "fashion-dataset",
    "heatmap": "gradient",
    "threshold": 90,
    "images":[ {
      "label": "bag",
      "filename": "18.png"
    }]
  }
}

settings {
  encodeUrl: true
}
