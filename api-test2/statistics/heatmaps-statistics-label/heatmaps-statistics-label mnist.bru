meta {
  name: heatmaps-statistics-label mnist
  type: http
  seq: 1
}

post {
  url: http://localhost:8000/heatmap/heatmaps-statistics-label
  body: json
  auth: inherit
}

body:json {
  {
    "model": "mnist",
    "dataset": "mnist-dataset",
    "heatmap": "gradient",
    "threshold": 25,
    "percentage": 10,
    "label": "seven"
  }
}

settings {
  encodeUrl: true
}
